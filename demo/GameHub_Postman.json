    {
      "name": "2. Авторизация и права",
      "item": [
        {
          "name": "Публичный каталог без токена",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/games/?limit=100",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "games",
                ""
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const list=pm.response.json().results; const game=list.find(x=>x.title==='Hades'); const zelda=list.find(x=>x.title.startsWith('The Legend of Zelda')); pm.expect(game).to.exist; pm.expect(zelda).to.exist; pm.collectionVariables.set('game_id',game.id); pm.collectionVariables.set('wrong_platform_game_id',zelda.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Получить платформы и сохранить PC",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/platforms/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "platforms",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r=pm.response.json(); const list=r.results || r; const pc=list.find(x=>x.slug==='pc') || list[0]; pm.expect(pc).to.exist; pm.collectionVariables.set('pc_platform_id', pc.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
